# =====================================================================
# Copy this file to .env.local for local work (VS Code). On Vercel, add
# the same names under Project -> Settings -> Environment Variables.
# =====================================================================

# ---- Admin login (REQUIRED) ----
# The password you type at /admin. Use something long and unique.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign the login cookie. Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-random-string

# ---- Database: Upstash Redis (REQUIRED on Vercel) ----
# Added automatically when you connect an Upstash Redis store in Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (the names KV_REST_API_URL / KV_REST_API_TOKEN also work)

# ---- Site address (recommended) ----
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ---- Email alerts (OPTIONAL, free at resend.com) ----
# With this set, you get an email whenever someone sends a message or
# leaves a testimonial. Without it everything still reaches /admin.
RESEND_API_KEY=
# Where alerts are delivered (defaults to the email in content/site.js).
# With Resend's free test sender this must be the email you signed up with.
NOTIFY_EMAIL=kedarsahu09@gmail.com
# Sender shown on alerts. Leave empty to use Resend's test sender.
NOTIFY_FROM=
