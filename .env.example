# ---- Admin login (required) ----
# Password you type at /admin. Use something long and unique.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign the login cookie. Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-random-string

# ---- Database (Upstash Redis) ----
# On Vercel these are added automatically when you connect an Upstash Redis store.
# Either naming style works:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
